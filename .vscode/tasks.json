{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keremhub: Ortak sürüm kontrolü",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/version.mjs", "--check"],
      "problemMatcher": []
    },
    {
      "label": "Keremhub: APK derle",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Keremhub: Sunucu testleri",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/apps/android/scripts/check-server.mjs"],
      "problemMatcher": []
    }
  ]
}

import {NextResponse} from "next/server";
import {validKoboToken} from "@/lib/kobo";
export const dynamic="force-dynamic";
export async function GET(req:Request,{params}:{params:Promise<{token:string}>}) {
 const {token}=await params;
 if(!(await validKoboToken(token))) return new Response("Not found",{status:404});
 const issuer=new URL(req.url).origin+"/keremkitabevi/kobo/"+token+"/oauth";
 return NextResponse.json({issuer,authorization_endpoint:issuer+"/authorize",token_endpoint:issuer+"/token",response_types_supported:["code"],grant_types_supported:["authorization_code","refresh_token"],code_challenge_methods_supported:["S256","plain"],subject_types_supported:["public"],scopes_supported:["openid","profile","email","offline_access","kobo_profile","public_api_authenticated"]},{headers:{"Cache-Control":"no-store"}});
}
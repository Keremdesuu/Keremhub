# Yeni bir siteyi yol (path) ile aynı IP'den açmak için örnek.
# Kullanım:
#   sudo cp ornek-site.conf.disabled /etc/nginx/keremhub.d/kitabevi.conf
#   (aşağıdaki yolu ve portu düzenle)
#   sudo nginx -t && sudo systemctl reload nginx
# Sonra portalda "Site ekle" ile adres olarak /kitabevi/ yaz.

location /kitabevi/ {
    proxy_pass http://127.0.0.1:3101/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
}

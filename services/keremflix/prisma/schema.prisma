generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Kind {
  SERIES
  MOVIE
  ANIME
}

model Title {
  id          Int      @id @default(autoincrement())
  kind        Kind
  folderName  String   @unique
  title       String
  originalTitle String?
  year        Int?
  overview    String?
  posterUrl   String?
  backdropUrl String?
  genres      String   @default("[]")
  cast        String   @default("[]")
  moods       String   @default("[]")
  rating      Float?
  certification String?
  runtime     Int?
  tmdbId      Int?
  anilistId   Int?
  metaStatus  String   @default("pending")
  addedAt     DateTime @default(now())
  episodes    Episode[]

  @@index([kind, addedAt])
}

model Episode {
  id        Int     @id @default(autoincrement())
  titleId   Int
  title     Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  season    Int     @default(1)
  number    Int     @default(1)
  name      String?
  filePath  String  @unique
  quality   String?
  sizeBytes BigInt  @default(0)
  progress  Progress?

  @@index([titleId, season, number])
}

model Progress {
  id        Int      @id @default(autoincrement())
  episodeId Int      @unique
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  seconds   Float    @default(0)
  duration  Float    @default(0)
  updatedAt DateTime @updatedAt
}

model ListItem {
  id      Int   @id @default(autoincrement())
  titleId Int   @unique
  addedAt DateTime @default(now())
}

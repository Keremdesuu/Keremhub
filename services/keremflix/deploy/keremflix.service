[Unit]
Description=Keremflix
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=NODE_ENV=production
EnvironmentFile=__DIR__/.env
ExecStart=__NODE__ __DIR__/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3200
Restart=on-failure
RestartSec=5
MemoryMax=700M

[Install]
WantedBy=multi-user.target

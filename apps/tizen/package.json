{
  "name": "keremflix-tizen",
  "version": "2.1.0",
  "private": true,
  "description": "Samsung Smart Monitor için bağımsız Keremflix istemcisi",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "tsc && node --check server/bridge.cjs",
    "preview": "node scripts/preview.cjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "build": "tsc && node scripts/build.mjs",
    "test:ui": "playwright test",
    "serve:pi": "node server/bridge.cjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
